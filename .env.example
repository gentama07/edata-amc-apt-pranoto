# Frontend. Gunakan Project URL dan publishable/anon key dari Supabase.
# Kunci browser memang terlihat di frontend; jangan gunakan secret/service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only: configure these with `supabase secrets set`. Never add a VITE_ prefix.
# APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
# APPS_SCRIPT_TOKEN=long-random-token-shared-with-your-Apps-Script-project
